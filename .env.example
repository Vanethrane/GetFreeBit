# Canonical site URL (no trailing slash). Also set domain in src/site.config.ts.
NEXT_PUBLIC_SITE_URL=https://www.getfreebit.com

# Free by default: Google TTS (no key) + dictionary audio + browser speech.
# Optional paid upgrade:
# TTS_PROVIDER=openai
# OPENAI_API_KEY=

# Optional Cloudflare R2 (omit to use local .cache/audio)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
